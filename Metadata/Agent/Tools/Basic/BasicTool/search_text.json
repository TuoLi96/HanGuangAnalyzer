{
  "type": "function",
  "function": {
    "name": "search_text",
    "description": "Search for fixed text in source files and return matching file paths, line numbers, and contents.",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Text to search for."
        },
        "path": {
          "type": "string",
          "description": "Directory relative to the search root. Defaults to the entire root."
        },
        "file_pattern": {
          "type": "string",
          "description": "Filename filter, e.g. *.c or *.h."
        },
        "case_sensitive": {
          "type": "boolean",
          "description": "Whether matching is case-sensitive."
        }
      },
      "required": ["query"]
    }
  }
}